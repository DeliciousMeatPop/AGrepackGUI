# Divinity: Original Sin (script 0.3.1)
#   Thanks to spider91 for the lz4f info.
# script for QuickBMS http://quickbms.aluigi.org

get PAK_NAME basename
get PAK_EXT extension

idstring "LSPK"
get VER long
get INFO_OFF longlong
goto INFO_OFF
get FILES long
get INFO_SIZE long
savepos OFFSET
xmath TMP "FILES * 272"
comtype lz4
clog MEMORY_FILE OFFSET INFO_SIZE TMP

math CURRENT_PAK = 0
for i = 0 < FILES
    getdstring NAME 256 MEMORY_FILE
    get OFFSET longlong MEMORY_FILE
    xmath PAK_NUM "OFFSET >> 48"
    math PAK_NUM & 0xff
    xmath ZIP "OFFSET >> 56"
    math ZIP & 0xf
    math OFFSET & 0xffffffffffff
    get ZSIZE long MEMORY_FILE
    get SIZE long MEMORY_FILE
    if ZIP == 0
        comtype copy
    elif ZIP == 1
        comtype zlib
    elif ZIP == 2
        comtype lz4
    else
        print "Error: unknown compression type %ZIP%"
        cleanexit
    endif

    if PAK_NUM != CURRENT_PAK
        if PAK_NUM == 0
            string TMP p "%s.%s"    PAK_NAME         PAK_EXT
        else
            string TMP p "%s_%d.%s" PAK_NAME PAK_NUM PAK_EXT
        endif
        open FDSE TMP
        math CURRENT_PAK = PAK_NUM
    endif

    if SIZE == 0
        log NAME OFFSET ZSIZE
    else
        clog NAME OFFSET ZSIZE SIZE
    endif
next i
