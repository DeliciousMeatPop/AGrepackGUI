__pycache__/
*.pyc
*.pyo
/_current source */

# Leftover temp compression scripts from interrupted runs
Resource/_tmp_*.bat

# PyInstaller build artefacts
build/
dist/
*.spec
version_info.txt

# XDelta patch maker (build output / generated / machine-specific)
XDelta/Output/
XDelta/ISXPMPatch/*.exe
XDelta/pdata/PatchData/
XDelta/pdata/Preprocessed.iss
XDelta/settings.ini
XDelta/setup.ini

# Archived old game art (generated by the repacker; stays local, shipped in release zips)
Setup/Background/_OldGameArt/

# Built exe is published under GitHub Releases, not tracked
/AG Repack GUI.exe

# Per-person saved repacker name
Resource/Save/repacker.txt

# isxpm-generated hash files (kept: folder placeholder only)
XDelta/checker/*
!XDelta/checker/.gitkeep

# Stray gude-*.log files created by a PowerShell glitch
gude-*.log

# Testing-remote upload: custom rclone build, its encrypted config and the remote map
# live next to the program on each repacker's PC and are never committed
/rclone.exe
/rclone.conf
/remotes.ini

# rclone log of the last upload
/rclone_upload.log

# AGTesting posting: site address and this PC's personal API token (never committed)
/agtesting.ini
/agtesting.token
